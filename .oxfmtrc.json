{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortPackageJson": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": true,
  "svelte": true,
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    }
  ]
}
