{
  "name": "bobbymannino",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "vite build",
    "start": "bun build/index.js",
    "preview": "bun --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt",
    "lint": "oxfmt --check && oxlint"
  },
  "dependencies": {
    "@giscus/svelte": "^3.1.0",
    "@sentry/sveltekit": "^11.11.0",
    "central-icons": "npm:@central-icons-svelte/square-filled-radius-0-stroke-2@^1.2.29",
    "marked": "^18.1.3",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.0",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@7",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "runed": "^0.38.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-inview": "^4.0.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6",
    "valibot": "^1.5.0",
    "vite": "^8.3.6"
  }
}
